# demo | local
AUTH_MODE=demo

# Required when AUTH_MODE=local (min 32 chars recommended)
AUTH_SECRET=change-me-to-a-long-random-string

# Public app URL (password-reset links)
APP_URL=http://localhost:3000

# PostgreSQL (required for AUTH_MODE=local)
DATABASE_URL=postgresql://forge:forge@127.0.0.1:5432/forge_starter

# Optional: enforce login even in demo mode
# AUTH_GUARD=true

# SMTP — custom / self-hosted / enterprise mail only (no cloud email SaaS SDK)
# Leave empty in demo; local forgot-password logs the reset link to the server console when SMTP is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Forge Starter <noreply@example.com>"
