# demo | local
# 不写时，开发环境按 demo。NODE_ENV=production 时 demo（含没写）会拒绝启动。
# 只有明确要做公开演示才设置 ALLOW_INSECURE_AUTH=true。
AUTH_MODE=demo

# 至少 32 位。local 必填。生产环境必填，除非显式 ALLOW_INSECURE_AUTH=true。
# 生成：openssl rand -base64 32
# 下面这行只是占位，能通过长度检查，不能拿去当生产密钥。
AUTH_SECRET=change-me-to-a-long-random-string

# Public app URL (password-reset links)
APP_URL=http://localhost:3000

# PostgreSQL (required for AUTH_MODE=local)
DATABASE_URL=postgresql://forge:replace-with-password@127.0.0.1:5432/forge_starter

# Login is required for app pages. Set false only to browse the shell without a session.
# AUTH_GUARD=false

# AI reference pages under /ref/* (default: on in development, off in production)
# SHOW_REF_PAGES=true

# SMTP — custom / self-hosted / enterprise mail only (no cloud email SaaS SDK)
# Leave empty in demo; local forgot-password logs the reset link to the server console when SMTP is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Forge Starter <noreply@example.com>"

# Ask AI — 服务端 OpenAI 兼容接口。密钥不要放进前端或请求体。
# Harness 使用模型服务中启用的模型，或下方环境变量；密钥不可进入浏览器。
# 表结构用 pnpm db:migrate。不要再手跑 docs/history/sql/ 里的旧脚本。
SEMANTIC_ENABLED=true
# 新客户端默认启用。false 为服务端停止接收新 harness 操作的开关。
ASK_AI_HARNESS_ENABLED=true
# ASK_AI_LLM_PROVIDER=dashscope
# ASK_AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASK_AI_LLM_MODEL=qwen-plus
# ASK_AI_LLM_THINK_MODEL=qwen-plus
# ASK_AI_LLM_API_KEY=

# docker compose requires a unique password; match the URL-encoded value in DATABASE_URL.
POSTGRES_PASSWORD=
