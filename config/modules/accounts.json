{
  "id": "accounts",
  "label": "账号管理",
  "order": 1,
  "permissionResource": "accounts",
  "menu": {
    "href": "/accounts/",
    "icon": "UsersGroupTwoRoundedBoldDuotone",
    "group": "main"
  },
  "knowledge": {
    "summary": "业务账号支持查询、搜索、状态筛选、全页详情、新建、编辑、删除、CSV 导出；详情含账号信息和会话信息。",
    "fields": "姓名、用户名、邮箱、手机、角色、部门、状态、备注。",
    "rules": "业务账号不是登录用户；用户名创建后不可改；状态有启用、停用、待激活、锁定。已有助手草稿和页面保存回执流程。",
    "source": "app/(app)/accounts/page.tsx"
  },
  "read": {
    "service": "lib/accounts/service.ts",
    "export": "listAdminAccounts",
    "fields": [
      "id",
      "name",
      "username",
      "email",
      "phone",
      "role",
      "department",
      "status",
      "notes",
      "revision",
      "updatedAt"
    ]
  },
  "entries": {
    "create": false,
    "detail": false,
    "edit": false
  },
  "tools": [
    {
      "source": "lib/accounts/agent.ts",
      "export": "accountAgentTools"
    }
  ],
  "draft": {
    "adapter": "specialized"
  }
}
